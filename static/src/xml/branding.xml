        <xpath expr="//small" position="replace">
            <small>© WeberQ Global Pvt. Ltd. · <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html" style="text-decoration: underline;">GNU LGPL Licensed</a></small>
        </xpath>
    </t>
</templates>
